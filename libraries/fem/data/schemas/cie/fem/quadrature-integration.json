{
    "$id" : "/cie/fem/quadrature-integration",
    "type" : "object",
    "description" : "Shared quadrature settings for the Dirichlet penalty contributions.",
    "allOf" : [
        {
            "oneOf" : [
                {"$ref" : "/cie/fem/gauss-legendre-quadrature"},
                {"$ref" : "/cie/fem/kd-tree-quadrature"}
            ]
        }
    ],
    "default" : {
        "type" : "kd-tree-quadrature",
        "template" : {
            "type" : "gauss-legendre-quadrature",
            "order" : 3
        },
        "min-tree-depth" : 0,
        "max-tree-depth" : 6,
        "min-domain-norm" : 1e-6
    }
}
