        },
        "device" : {
            "type" : "string",
            "enum" : ["host", "sycl"],
            "default" : "host",
            "description" : "Device to evaluate integrands on."
        },
        "max-tile-sizes" : {
            "type" : ["array", "null"],
            "default" : null,
            "items" : {
                "type" : ["integer", "null"],
                "minimum" : 1
            },
            "description" : "Maximum tile extent in each ansatz-context dimension; null uses the complete active extent."
        },
        "verbosity" : {
            "type" : "integer",
            "minimum" : 0,
            "maximum" : 4,
            "default" : 1,
            "description" : "Level of logging during iterations (0 - none, 1 - warnings, 2 - summaries, 3 - iteration summaries, 4 - debug)."
        }
    },
    "required" : []
}
